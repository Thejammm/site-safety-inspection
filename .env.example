# AHS Site Safety Inspection — environment variables
# Copy to .env for local dev (never commit .env). In production these are
# set in Coolify → the application → Environment Variables.

# Port the server listens on (Coolify maps its proxy to this).
PORT=3000

# Node environment. Use 'production' in deployment (enables secure cookies over HTTPS).
NODE_ENV=production

# Secret used to sign the session JWT. Must be >= 32 characters.
# Generate a fresh random value; do not reuse across apps.
SESSION_SECRET=

# Postgres connection string for this app's dedicated database.
DATABASE_URL=

# First-run admin seeding (creates the first consultant user if none exists).
# Optional after the first successful boot; remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
